{
  "name": "dsh-transparent-frosted",
  "version": "1.0.2",
  "type": "module",
  "description": "Transparent frosted-glass background for DeepSeek Harness (dsh) — one slider from real frosted glass to a fully cleared background, a separate settings-page slider, and an optional particle whale. Works on dsh web, Windows and macOS.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "client.js",
    "index.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale",
    "README.md",
    "LICENSE",
    "docs",
    "screenshots.json"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-theme"
      ]
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "theme",
    "plugin",
    "glass",
    "frosted",
    "acrylic",
    "transparency",
    "backdrop-filter",
    "particles"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Yuanqs-pine/DSH-Transparent-Frosted.git"
  },
  "homepage": "https://github.com/Yuanqs-pine/DSH-Transparent-Frosted#readme",
  "bugs": {
    "url": "https://github.com/Yuanqs-pine/DSH-Transparent-Frosted/issues"
  }
}
